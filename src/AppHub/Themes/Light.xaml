<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options">
  <Color x:Key="AppBgColor">#F4F7FB</Color>
  <Color x:Key="CardBgColor">#FFFFFF</Color>
  <Color x:Key="PrimaryColor">#0F172A</Color>
  <Color x:Key="AccentColor">#0EA5E9</Color>
  <Color x:Key="SuccessColor">#16A34A</Color>
  <Color x:Key="WarningColor">#D97706</Color>
  <Color x:Key="DangerColor">#DC2626</Color>
  <Color x:Key="TextColor">#0F172A</Color>
  <Color x:Key="SubtleTextColor">#475569</Color>
  <Color x:Key="BorderColor">#DCE5F0</Color>
  <Color x:Key="HoverBgColor">#EEF4FB</Color>

  <SolidColorBrush x:Key="AppBgBrush" po:Freeze="False" Color="#F4F7FB" />
  <SolidColorBrush x:Key="PageRootBgBrush" po:Freeze="False" Color="#F4F7FB" />
  <SolidColorBrush x:Key="CardBgBrush" po:Freeze="False" Color="#FFFFFF" />
  <SolidColorBrush x:Key="SidebarBgBrush" po:Freeze="False" Color="#FFFFFF" />
  <SolidColorBrush x:Key="ProgramCardBgBrush" po:Freeze="False" Color="#FFFFFF" />
  <LinearGradientBrush x:Key="AppSurfaceBrush" StartPoint="0,0" EndPoint="1,1">
    <GradientStop Offset="0" Color="#F4F7FB" />
    <GradientStop Offset="1" Color="#EEF4FF" />
  </LinearGradientBrush>

  <SolidColorBrush x:Key="PrimaryBrush" po:Freeze="False" Color="#0F172A" />
  <SolidColorBrush x:Key="PrimaryHoverBrush" po:Freeze="False" Color="#1E293B" />
  <SolidColorBrush x:Key="PrimaryPressedBrush" po:Freeze="False" Color="#334155" />

  <SolidColorBrush x:Key="SuccessButtonBrush" po:Freeze="False" Color="#16A34A" />
  <SolidColorBrush x:Key="SuccessButtonHoverBrush" po:Freeze="False" Color="#22C55E" />
  <SolidColorBrush x:Key="SuccessButtonPressedBrush" po:Freeze="False" Color="#15803D" />

  <SolidColorBrush x:Key="DangerBrush" po:Freeze="False" Color="#DC2626" />
  <SolidColorBrush x:Key="DangerHoverBrush" po:Freeze="False" Color="#EF4444" />
  <SolidColorBrush x:Key="DangerPressedBrush" po:Freeze="False" Color="#B91C1C" />
  <SolidColorBrush x:Key="DangerSubtleBgBrush" po:Freeze="False" Color="#FEE2E2" />

  <SolidColorBrush x:Key="AccentBrush" po:Freeze="False" Color="#0284C7" />
  <SolidColorBrush x:Key="SuccessBrush" po:Freeze="False" Color="#16A34A" />
  <SolidColorBrush x:Key="WarningBrush" po:Freeze="False" Color="#D97706" />
  <SolidColorBrush x:Key="TextBrush" po:Freeze="False" Color="#0F172A" />
  <SolidColorBrush x:Key="SubtleTextBrush" po:Freeze="False" Color="#475569" />
  <SolidColorBrush x:Key="BorderBrush" po:Freeze="False" Color="#DCE5F0" />
  <SolidColorBrush x:Key="HoverBgBrush" po:Freeze="False" Color="#EEF4FB" />
  <SolidColorBrush x:Key="AmbientGlowBrush" po:Freeze="False" Color="#DAE8FF" />

  <SolidColorBrush x:Key="SelectedBgBrush" po:Freeze="False" Color="#160284C7" />
  <SolidColorBrush x:Key="SelectedBorderBrush" po:Freeze="False" Color="#660284C7" />
  <SolidColorBrush x:Key="DropTargetBgBrush" po:Freeze="False" Color="#1A16A34A" />
  <SolidColorBrush x:Key="BadgeBgBrush" po:Freeze="False" Color="#E0F2FE" />
  <SolidColorBrush x:Key="RunningBadgeBgBrush" po:Freeze="False" Color="#DCFCE7" />
  <SolidColorBrush x:Key="LaunchingBadgeBgBrush" po:Freeze="False" Color="#FEF3C7" />
  <SolidColorBrush x:Key="ToastBgBrush" po:Freeze="False" Color="#FFFFFF" />

  <SolidColorBrush x:Key="DisabledBgBrush" po:Freeze="False" Color="#CBD5E1" />
  <SolidColorBrush x:Key="DisabledBorderBrush" po:Freeze="False" Color="#E2E8F0" />
  <SolidColorBrush x:Key="DisabledTextBrush" po:Freeze="False" Color="#94A3B8" />

  <SolidColorBrush x:Key="ScrollBarTrackBrush" po:Freeze="False" Color="#00FFFFFF" />
  <SolidColorBrush x:Key="ScrollBarThumbBrush" po:Freeze="False" Color="#33000000" />
  <SolidColorBrush x:Key="ScrollBarThumbHoverBrush" po:Freeze="False" Color="#66000000" />
  <SolidColorBrush x:Key="ScrollBarThumbPressedBrush" po:Freeze="False" Color="#8C000000" />
</ResourceDictionary>
