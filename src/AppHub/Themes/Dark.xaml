<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options">
  <Color x:Key="AppBgColor">#06101D</Color>
  <Color x:Key="CardBgColor">#101A2B</Color>
  <Color x:Key="PrimaryColor">#2563EB</Color>
  <Color x:Key="AccentColor">#38BDF8</Color>
  <Color x:Key="SuccessColor">#30D16F</Color>
  <Color x:Key="WarningColor">#FBBF24</Color>
  <Color x:Key="DangerColor">#EF4444</Color>
  <Color x:Key="TextColor">#EAF2FF</Color>
  <Color x:Key="SubtleTextColor">#94A8C6</Color>
  <Color x:Key="BorderColor">#26354A</Color>
  <Color x:Key="HoverBgColor">#172842</Color>

  <SolidColorBrush x:Key="AppBgBrush" po:Freeze="False" Color="#06101D" />
  <SolidColorBrush x:Key="PageRootBgBrush" po:Freeze="False" Color="#06101D" />
  <SolidColorBrush x:Key="CardBgBrush" po:Freeze="False" Color="#101A2B" />
  <SolidColorBrush x:Key="SidebarBgBrush" po:Freeze="False" Color="#081321" />
  <SolidColorBrush x:Key="ProgramCardBgBrush" po:Freeze="False" Color="#101A2B" />
  <LinearGradientBrush x:Key="AppSurfaceBrush" StartPoint="0,0" EndPoint="1,1">
    <GradientStop Offset="0" Color="#06101D" />
    <GradientStop Offset="1" Color="#0B192C" />
  </LinearGradientBrush>

  <SolidColorBrush x:Key="PrimaryBrush" po:Freeze="False" Color="#2563EB" />
  <SolidColorBrush x:Key="PrimaryHoverBrush" po:Freeze="False" Color="#3B82F6" />
  <SolidColorBrush x:Key="PrimaryPressedBrush" po:Freeze="False" Color="#1D4ED8" />

  <SolidColorBrush x:Key="SuccessButtonBrush" po:Freeze="False" Color="#1F9F6B" />
  <SolidColorBrush x:Key="SuccessButtonHoverBrush" po:Freeze="False" Color="#29AD76" />
  <SolidColorBrush x:Key="SuccessButtonPressedBrush" po:Freeze="False" Color="#198257" />

  <SolidColorBrush x:Key="DangerBrush" po:Freeze="False" Color="#DC2626" />
  <SolidColorBrush x:Key="DangerHoverBrush" po:Freeze="False" Color="#EF4444" />
  <SolidColorBrush x:Key="DangerPressedBrush" po:Freeze="False" Color="#B91C1C" />
  <SolidColorBrush x:Key="DangerSubtleBgBrush" po:Freeze="False" Color="#2D161B" />

  <SolidColorBrush x:Key="AccentBrush" po:Freeze="False" Color="#38BDF8" />
  <SolidColorBrush x:Key="SuccessBrush" po:Freeze="False" Color="#30D16F" />
  <SolidColorBrush x:Key="WarningBrush" po:Freeze="False" Color="#FBBF24" />
  <SolidColorBrush x:Key="TextBrush" po:Freeze="False" Color="#EAF2FF" />
  <SolidColorBrush x:Key="SubtleTextBrush" po:Freeze="False" Color="#94A8C6" />
  <SolidColorBrush x:Key="BorderBrush" po:Freeze="False" Color="#26354A" />
  <SolidColorBrush x:Key="HoverBgBrush" po:Freeze="False" Color="#172842" />
  <SolidColorBrush x:Key="AmbientGlowBrush" po:Freeze="False" Color="#122742" />

  <SolidColorBrush x:Key="SelectedBgBrush" po:Freeze="False" Color="#262F87FF" />
  <SolidColorBrush x:Key="SelectedBorderBrush" po:Freeze="False" Color="#8838BDF8" />
  <SolidColorBrush x:Key="DropTargetBgBrush" po:Freeze="False" Color="#2230D16F" />
  <SolidColorBrush x:Key="BadgeBgBrush" po:Freeze="False" Color="#162C46" />
  <SolidColorBrush x:Key="RunningBadgeBgBrush" po:Freeze="False" Color="#123125" />
  <SolidColorBrush x:Key="LaunchingBadgeBgBrush" po:Freeze="False" Color="#332711" />
  <SolidColorBrush x:Key="ToastBgBrush" po:Freeze="False" Color="#152236" />

  <SolidColorBrush x:Key="DisabledBgBrush" po:Freeze="False" Color="#1F2937" />
  <SolidColorBrush x:Key="DisabledBorderBrush" po:Freeze="False" Color="#334155" />
  <SolidColorBrush x:Key="DisabledTextBrush" po:Freeze="False" Color="#64748B" />

  <SolidColorBrush x:Key="ScrollBarTrackBrush" po:Freeze="False" Color="#00FFFFFF" />
  <SolidColorBrush x:Key="ScrollBarThumbBrush" po:Freeze="False" Color="#47FFFFFF" />
  <SolidColorBrush x:Key="ScrollBarThumbHoverBrush" po:Freeze="False" Color="#80FFFFFF" />
  <SolidColorBrush x:Key="ScrollBarThumbPressedBrush" po:Freeze="False" Color="#9EFFFFFF" />
</ResourceDictionary>
