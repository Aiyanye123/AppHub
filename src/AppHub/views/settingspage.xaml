<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="AppHub.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:system="clr-namespace:System;assembly=mscorlib"
             xmlns:viewModels="clr-namespace:AppHub.ViewModels"
             xmlns:models="clr-namespace:AppHub.Models"
             Loaded="OnLoaded">
  <FrameworkElement.DataContext>
    <viewModels:SettingsViewModel />
  </FrameworkElement.DataContext>
  <UserControl.Resources>
    <Style x:Key="SectionIcon" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource IconGlyph}">
      <Setter Property="FontSize" Value="17" />
      <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
    </Style>
    <Style x:Key="SectionTitle" TargetType="{x:Type TextBlock}">
      <Setter Property="FontSize" Value="15.5" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
      <Setter Property="Margin" Value="10,0,0,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="RowTitle" TargetType="{x:Type TextBlock}">
      <Setter Property="FontSize" Value="13.5" />
      <Setter Property="FontWeight" Value="Medium" />
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    </Style>
    <Style x:Key="RowDescription" TargetType="{x:Type TextBlock}">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{DynamicResource SubtleTextBrush}" />
      <Setter Property="Margin" Value="0,3,0,0" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
  </UserControl.Resources>

  <Grid Background="{DynamicResource PageRootBgBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Margin="28,22,28,32" MaxWidth="920" HorizontalAlignment="Stretch">
        <TextBlock Text="设置" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" />
        <TextBlock Text="管理界面外观、启动策略、系统集成与数据备份" FontSize="12.5" Foreground="{DynamicResource SubtleTextBrush}" Margin="0,4,0,22" />

        <!-- 1. 外观与个性化 -->
        <Border Style="{StaticResource PanelBorder}" Padding="22" Margin="0,0,0,16">
          <StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
              <TextBlock Text="&#xE790;" Style="{StaticResource SectionIcon}" />
              <TextBlock Text="外观与个性化" Style="{StaticResource SectionTitle}" />
            </StackPanel>

            <!-- 主题与密度 -->
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel VerticalAlignment="Center">
                <TextBlock Text="应用主题" Style="{StaticResource RowTitle}" />
                <TextBlock Text="切换浅色或深色界面配色方案，窗口标题栏将自动同步" Style="{StaticResource RowDescription}" />
              </StackPanel>
              <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <RadioButton Content="浅色模式"
                             GroupName="AppThemeSelector"
                             Click="OnLightThemeClick">
                  <RadioButton.Style>
                    <Style TargetType="{x:Type RadioButton}" BasedOn="{StaticResource FilterChipRadioButton}">
                      <Setter Property="IsChecked" Value="False" />
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding IsDarkMode}" Value="False">
                          <Setter Property="IsChecked" Value="True" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </RadioButton.Style>
                </RadioButton>
                <RadioButton Content="深色模式"
                             GroupName="AppThemeSelector"
                             Margin="0"
                             Click="OnDarkThemeClick">
                  <RadioButton.Style>
                    <Style TargetType="{x:Type RadioButton}" BasedOn="{StaticResource FilterChipRadioButton}">
                      <Setter Property="IsChecked" Value="False" />
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding IsDarkMode}" Value="True">
                          <Setter Property="IsChecked" Value="True" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </RadioButton.Style>
                </RadioButton>
              </StackPanel>
            </Grid>

            <Separator Margin="0,14" Background="{DynamicResource BorderBrush}" />

            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel VerticalAlignment="Center">
                <TextBlock Text="紧凑列表模式" Style="{StaticResource RowTitle}" />
                <TextBlock Text="开启后隐藏列表中的路径副标题，单屏可容纳更多应用" Style="{StaticResource RowDescription}" />
              </StackPanel>
              <CheckBox Grid.Column="1" Content="启用紧凑行高" IsChecked="{Binding IsCompactList}" VerticalAlignment="Center" />
            </Grid>

            <Separator Margin="0,16" Background="{DynamicResource BorderBrush}" />

            <!-- 背景设置 Tab 切换 -->
            <DockPanel Margin="0,0,0,14">
              <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <RadioButton Content="亮色模式背景"
                             GroupName="BgThemeTab"
                             Style="{StaticResource FilterChipRadioButton}"
                             IsChecked="{Binding IsEditingLightBackground, Mode=TwoWay}" />
                <RadioButton Content="暗色模式背景"
                             GroupName="BgThemeTab"
                             Margin="0"
                             Style="{StaticResource FilterChipRadioButton}"
                             IsChecked="{Binding IsEditingDarkBackground, Mode=TwoWay}" />
              </StackPanel>
              <StackPanel VerticalAlignment="Center">
                <TextBlock Text="自定义背景图片与效果" Style="{StaticResource RowTitle}" />
                <TextBlock Text="可分别为亮色和暗色模式配置独立的壁纸与磨砂/暗化滤镜" Style="{StaticResource RowDescription}" />
              </StackPanel>
            </DockPanel>

            <!-- 亮色背景设置面板 -->
            <Border Background="{DynamicResource HoverBgBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="16"
                    Visibility="{Binding IsEditingLightBackground, Converter={StaticResource BooleanToVisibilityConverter}}">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="160" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,16,0">
                  <TextBlock Text="亮色背景图片路径" FontSize="12.5" Foreground="{DynamicResource SubtleTextBrush}" Margin="0,0,0,6" />
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" Text="{Binding LightBackgroundImagePath, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="True" />
                    <Button Grid.Column="1" Margin="8,0,0,0" Content="选择图片" Style="{StaticResource SecondaryButton}" Click="OnBrowseLightBackgroundImage" />
                    <Button Grid.Column="2" Margin="8,0,0,0" Content="重置" Style="{StaticResource SubtleButton}" Click="OnResetLightBackgroundImage" />
                  </Grid>

                  <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="110" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="亮色背景方案" VerticalAlignment="Center" Foreground="{DynamicResource TextBrush}" />
                    <ComboBox Grid.Row="0" Grid.Column="1" Width="220" HorizontalAlignment="Left" SelectedValuePath="Tag" SelectedValue="{Binding LightBackgroundStyle, Mode=TwoWay}">
                      <ComboBoxItem Content="仅背景图" Tag="{x:Static models:BackgroundStyle.ImageOnly}" />
                      <ComboBoxItem Content="玻璃磨砂" Tag="{x:Static models:BackgroundStyle.FrostedGlass}" />
                      <ComboBoxItem Content="暗化聚焦" Tag="{x:Static models:BackgroundStyle.Dimmed}" />
                      <ComboBoxItem Content="关闭背景效果" Tag="{x:Static models:BackgroundStyle.None}" />
                    </ComboBox>

                    <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,14,0,0" Text="效果强度" VerticalAlignment="Center" Foreground="{DynamicResource TextBrush}" />
                    <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,14,0,0" VerticalAlignment="Center">
                      <Slider Width="220" Minimum="0" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding LightBackgroundEffectStrength, Mode=TwoWay}" VerticalAlignment="Center" IsEnabled="{Binding IsLightEffectStrengthEnabled}" />
                      <TextBlock Width="48" Margin="10,0,0,0" VerticalAlignment="Center" TextAlignment="Right" Foreground="{DynamicResource SubtleTextBrush}" Text="{Binding LightBackgroundEffectStrength, StringFormat={}{0:F0}%}" />
                      <Button Margin="10,0,0,0" Content="默认" Style="{StaticResource SubtleButton}" Padding="8,4" Click="OnResetLightBackgroundStrength" IsEnabled="{Binding IsLightEffectStrengthEnabled}" />
                    </StackPanel>
                  </Grid>
                </StackPanel>

                <!-- 亮色壁纸缩略预览 -->
                <Border Grid.Column="1"
                        Height="104"
                        CornerRadius="8"
                        Background="{DynamicResource CardBgBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        ClipToBounds="True"
                        VerticalAlignment="Center">
                  <Grid>
                    <TextBlock Text="未设置亮色壁纸" FontSize="11.5" Foreground="{DynamicResource SubtleTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <Image Source="{Binding LightBackgroundPreview}" Stretch="UniformToFill" Visibility="{Binding HasLightBackgroundPreview, Converter={StaticResource BooleanToVisibilityConverter}}" />
                  </Grid>
                </Border>
              </Grid>
            </Border>

            <!-- 暗色背景设置面板 -->
            <Border Background="{DynamicResource HoverBgBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="16"
                    Visibility="{Binding IsEditingDarkBackground, Converter={StaticResource BooleanToVisibilityConverter}}">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="160" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,16,0">
                  <TextBlock Text="暗色背景图片路径" FontSize="12.5" Foreground="{DynamicResource SubtleTextBrush}" Margin="0,0,0,6" />
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" Text="{Binding DarkBackgroundImagePath, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="True" />
                    <Button Grid.Column="1" Margin="8,0,0,0" Content="选择图片" Style="{StaticResource SecondaryButton}" Click="OnBrowseDarkBackgroundImage" />
                    <Button Grid.Column="2" Margin="8,0,0,0" Content="重置" Style="{StaticResource SubtleButton}" Click="OnResetDarkBackgroundImage" />
                  </Grid>

                  <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="110" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="暗色背景方案" VerticalAlignment="Center" Foreground="{DynamicResource TextBrush}" />
                    <ComboBox Grid.Row="0" Grid.Column="1" Width="220" HorizontalAlignment="Left" SelectedValuePath="Tag" SelectedValue="{Binding DarkBackgroundStyle, Mode=TwoWay}">
                      <ComboBoxItem Content="仅背景图" Tag="{x:Static models:BackgroundStyle.ImageOnly}" />
                      <ComboBoxItem Content="玻璃磨砂" Tag="{x:Static models:BackgroundStyle.FrostedGlass}" />
                      <ComboBoxItem Content="暗化聚焦" Tag="{x:Static models:BackgroundStyle.Dimmed}" />
                      <ComboBoxItem Content="关闭背景效果" Tag="{x:Static models:BackgroundStyle.None}" />
                    </ComboBox>

                    <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,14,0,0" Text="效果强度" VerticalAlignment="Center" Foreground="{DynamicResource TextBrush}" />
                    <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,14,0,0" VerticalAlignment="Center">
                      <Slider Width="220" Minimum="0" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding DarkBackgroundEffectStrength, Mode=TwoWay}" VerticalAlignment="Center" IsEnabled="{Binding IsDarkEffectStrengthEnabled}" />
                      <TextBlock Width="48" Margin="10,0,0,0" VerticalAlignment="Center" TextAlignment="Right" Foreground="{DynamicResource SubtleTextBrush}" Text="{Binding DarkBackgroundEffectStrength, StringFormat={}{0:F0}%}" />
                      <Button Margin="10,0,0,0" Content="默认" Style="{StaticResource SubtleButton}" Padding="8,4" Click="OnResetDarkBackgroundStrength" IsEnabled="{Binding IsDarkEffectStrengthEnabled}" />
                    </StackPanel>
                  </Grid>
                </StackPanel>

                <!-- 暗色壁纸缩略预览 -->
                <Border Grid.Column="1"
                        Height="104"
                        CornerRadius="8"
                        Background="{DynamicResource CardBgBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        ClipToBounds="True"
                        VerticalAlignment="Center">
                  <Grid>
                    <TextBlock Text="未设置暗色壁纸" FontSize="11.5" Foreground="{DynamicResource SubtleTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <Image Source="{Binding DarkBackgroundPreview}" Stretch="UniformToFill" Visibility="{Binding HasDarkBackgroundPreview, Converter={StaticResource BooleanToVisibilityConverter}}" />
                  </Grid>
                </Border>
              </Grid>
            </Border>

            <!-- 全局面板不透明度（独立于 Tab 之外，明确对两种模式均生效） -->
            <Grid Margin="0,16,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel VerticalAlignment="Center">
                <TextBlock Text="面板不透明度（全局）" Style="{StaticResource RowTitle}" />
                <TextBlock Text="同时作用于浅色与深色模式下的侧边栏和列表面板（最低 78% 以保障背景图上的文字清晰可读）" Style="{StaticResource RowDescription}" />
              </StackPanel>
              <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Slider Width="180" Minimum="78" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding PanelOpacity, Mode=TwoWay}" VerticalAlignment="Center" />
                <TextBlock Width="46" Margin="10,0,0,0" VerticalAlignment="Center" TextAlignment="Right" Foreground="{DynamicResource SubtleTextBrush}" Text="{Binding PanelOpacity, StringFormat={}{0:F0}%}" />
                <Button Margin="10,0,0,0" Content="重置" Style="{StaticResource SubtleButton}" Padding="10,5" Click="OnResetPanelOpacity" />
              </StackPanel>
            </Grid>
          </StackPanel>
        </Border>

        <!-- 2. 启动与进程行为 -->
        <Border Style="{StaticResource PanelBorder}" Padding="22" Margin="0,0,0,16">
          <StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
              <TextBlock Text="&#xE945;" Style="{StaticResource SectionIcon}" />
              <TextBlock Text="启动与进程行为" Style="{StaticResource SectionTitle}" />
            </StackPanel>

            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel VerticalAlignment="Center">
                <TextBlock Text="默认启动行为" Style="{StaticResource RowTitle}" />
                <TextBlock Text="选择点击启动时是总是启动新进程，还是优先激活已在运行的窗口" Style="{StaticResource RowDescription}" />
              </StackPanel>
              <ComboBox Grid.Column="1" Width="220" VerticalAlignment="Center" SelectedValuePath="Tag" SelectedValue="{Binding LaunchBehavior, Mode=TwoWay}">
                <ComboBoxItem Content="总是新开实例" Tag="{x:Static models:LaunchBehavior.NewInstance}" />
                <ComboBoxItem Content="优先切换到已运行窗口" Tag="{x:Static models:LaunchBehavior.FocusExisting}" />
              </ComboBox>
            </Grid>

            <Separator Margin="0,14" Background="{DynamicResource BorderBrush}" />

            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel VerticalAlignment="Center">
                <TextBlock Text="状态刷新间隔" Style="{StaticResource RowTitle}" />
                <TextBlock Text="前台自动检测进程运行状态的时间间隔（范围 1 - 60 秒，最小化到托盘后自动降低频率）" Style="{StaticResource RowDescription}" />
              </StackPanel>
              <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Slider Width="180" Minimum="1" Maximum="60" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding RefreshIntervalSeconds, Mode=TwoWay}" VerticalAlignment="Center" />
                <TextBlock Width="52" Margin="10,0,0,0" VerticalAlignment="Center" TextAlignment="Right" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" Text="{Binding RefreshIntervalSeconds, StringFormat={}{0:0} 秒}" />
              </StackPanel>
            </Grid>

            <Separator Margin="0,14" Background="{DynamicResource BorderBrush}" />

            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel VerticalAlignment="Center">
                <TextBlock Text="优雅关闭等待时间" Style="{StaticResource RowTitle}" />
                <TextBlock Text="发送关闭指令后等待应用自行退出的最长时间（范围 1 - 120 秒）" Style="{StaticResource RowDescription}" />
              </StackPanel>
              <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Slider Width="180" Minimum="1" Maximum="120" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding CloseGracePeriodSeconds, Mode=TwoWay}" VerticalAlignment="Center" />
                <TextBlock Width="52" Margin="10,0,0,0" VerticalAlignment="Center" TextAlignment="Right" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" Text="{Binding CloseGracePeriodSeconds, StringFormat={}{0:0} 秒}" />
              </StackPanel>
            </Grid>

            <Separator Margin="0,14" Background="{DynamicResource BorderBrush}" />

            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel VerticalAlignment="Center">
                <TextBlock Text="允许强制终止进程" Style="{StaticResource RowTitle}" />
                <TextBlock Text="当应用超过优雅关闭等待时间仍无响应时，允许强制结束进程" Style="{StaticResource RowDescription}" />
              </StackPanel>
              <CheckBox Grid.Column="1" Content="允许强制结束" IsChecked="{Binding AllowForceKill}" VerticalAlignment="Center" />
            </Grid>
          </StackPanel>
        </Border>

        <!-- 3. 系统集成 -->
        <Border Style="{StaticResource PanelBorder}" Padding="22" Margin="0,0,0,16">
          <StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
              <TextBlock Text="&#xE770;" Style="{StaticResource SectionIcon}" />
              <TextBlock Text="系统集成" Style="{StaticResource SectionTitle}" />
            </StackPanel>

            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel VerticalAlignment="Center">
                <TextBlock Text="开机自动启动" Style="{StaticResource RowTitle}" />
                <TextBlock Text="登录 Windows 时自动在后台启动 AppHub" Style="{StaticResource RowDescription}" />
              </StackPanel>
              <CheckBox Grid.Column="1" Content="开机自启" IsChecked="{Binding AutoStart}" VerticalAlignment="Center" />
            </Grid>

            <Separator Margin="0,14" Background="{DynamicResource BorderBrush}" />

            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel VerticalAlignment="Center">
                <TextBlock Text="窗口始终置顶" Style="{StaticResource RowTitle}" />
                <TextBlock Text="保持 AppHub 主窗口固定在其他普通窗口上方" Style="{StaticResource RowDescription}" />
              </StackPanel>
              <CheckBox Grid.Column="1" Content="始终置顶" IsChecked="{Binding AlwaysOnTop}" VerticalAlignment="Center" />
            </Grid>

            <Separator Margin="0,14" Background="{DynamicResource BorderBrush}" />

            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel VerticalAlignment="Center">
                <TextBlock Text="托盘常用条数" Style="{StaticResource RowTitle}" />
                <TextBlock Text="托盘菜单“常用”分区展示的置顶与最近启动应用数量上限（0 表示隐藏该分区）" Style="{StaticResource RowDescription}" />
              </StackPanel>
              <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Slider Width="180" Minimum="0" Maximum="15" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding TrayFrequentCount, Mode=TwoWay}" VerticalAlignment="Center" />
                <TextBlock Width="52" Margin="10,0,0,0" VerticalAlignment="Center" TextAlignment="Right" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" Text="{Binding TrayFrequentCountText}" />
              </StackPanel>
            </Grid>

            <Separator Margin="0,14" Background="{DynamicResource BorderBrush}" />

            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock Text="关闭按钮" Style="{StaticResource RowTitle}" VerticalAlignment="Center" />
              <ComboBox Grid.Column="1" Width="220" SelectedValuePath="Tag" SelectedValue="{Binding CloseToTray, Mode=TwoWay}">
                <ComboBoxItem Content="最小化到托盘">
                  <ComboBoxItem.Tag><system:Boolean>True</system:Boolean></ComboBoxItem.Tag>
                </ComboBoxItem>
                <ComboBoxItem Content="退出 AppHub">
                  <ComboBoxItem.Tag><system:Boolean>False</system:Boolean></ComboBoxItem.Tag>
                </ComboBoxItem>
              </ComboBox>
            </Grid>

            <Separator Margin="0,14" Background="{DynamicResource BorderBrush}" />

            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock Text="托盘左键" Style="{StaticResource RowTitle}" VerticalAlignment="Center" />
              <ComboBox Grid.Column="1" Width="220" SelectedValuePath="Tag" SelectedValue="{Binding TrayLeftClickAction, Mode=TwoWay}">
                <ComboBoxItem Content="打开主窗口" Tag="{x:Static models:TrayLeftClickAction.OpenWindow}" />
                <ComboBoxItem Content="弹出应用菜单" Tag="{x:Static models:TrayLeftClickAction.ShowMenu}" />
              </ComboBox>
            </Grid>

            <Separator Margin="0,14" Background="{DynamicResource BorderBrush}" />

            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                <TextBlock Text="全局快捷键" Style="{StaticResource RowTitle}" />
                <TextBlock Text="呼出主窗口并聚焦搜索框，留空关闭" Style="{StaticResource RowDescription}" />
              </StackPanel>
              <StackPanel Grid.Column="1" Width="220" VerticalAlignment="Center">
                <TextBox Text="{Binding GlobalHotkey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ToolTip="例如 Ctrl+Alt+Space" />
                <TextBlock Text="{Binding GlobalHotkeyError}"
                           Foreground="{DynamicResource DangerBrush}"
                           FontSize="12"
                           TextWrapping="Wrap"
                           Margin="0,5,0,0"
                           Visibility="{Binding HasGlobalHotkeyError, Converter={StaticResource BooleanToVisibilityConverter}}" />
              </StackPanel>
            </Grid>
          </StackPanel>
        </Border>

        <!-- 4. 数据备份与日志 -->
        <Border Style="{StaticResource PanelBorder}" Padding="22">
          <StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
              <TextBlock Text="&#xE74E;" Style="{StaticResource SectionIcon}" />
              <TextBlock Text="数据备份与日志" Style="{StaticResource SectionTitle}" />
            </StackPanel>

            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel VerticalAlignment="Center">
                <TextBlock Text="配置文件备份与恢复" Style="{StaticResource RowTitle}" />
                <TextBlock Text="导出或恢复应用列表、分组、置顶状态与设置项" Style="{StaticResource RowDescription}" />
              </StackPanel>
              <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="导出配置" Click="OnExportConfig" />
                <Button Margin="10,0,0,0" Content="导入配置" Style="{StaticResource SecondaryButton}" Click="OnImportConfig" />
              </StackPanel>
            </Grid>

            <Separator Margin="0,16" Background="{DynamicResource BorderBrush}" />

            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel VerticalAlignment="Center">
                <TextBlock Text="运行日志记录" Style="{StaticResource RowTitle}" />
                <TextBlock Text="记录应用启动与进程控制事件，便于排查异常" Style="{StaticResource RowDescription}" />
              </StackPanel>
              <CheckBox Grid.Column="1" Content="启用日志" IsChecked="{Binding IsLoggingEnabled}" VerticalAlignment="Center" />
            </Grid>

            <TextBlock Text="日志存储目录" FontSize="12.5" Foreground="{DynamicResource SubtleTextBrush}" Margin="0,14,0,6" />
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBox Grid.Column="0" Text="{Binding LogDirectory, UpdateSourceTrigger=PropertyChanged}" />
              <Button Grid.Column="1" Margin="8,0,0,0" Content="浏览目录" Style="{StaticResource SecondaryButton}" Click="OnBrowseLogDirectory" />
              <Button Grid.Column="2" Margin="8,0,0,0" Content="打开文件夹" Style="{StaticResource SecondaryButton}" Click="OnOpenLogs" />
            </Grid>

            <Grid Margin="0,14,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel VerticalAlignment="Center">
                <TextBlock Text="单日日志最大占用" Style="{StaticResource RowTitle}" />
                <TextBlock Text="0 表示不限制，超出上限后自动清理当日日志文件" Style="{StaticResource RowDescription}" />
              </StackPanel>
              <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBox Width="96" Text="{Binding LogMaxSizeMb, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Text="MB" VerticalAlignment="Center" Margin="8,0,16,0" Foreground="{DynamicResource SubtleTextBrush}" />
                <Button Content="删除所有日志" Style="{StaticResource DangerButton}" Click="OnDeleteAllLogs" />
              </StackPanel>
            </Grid>
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
