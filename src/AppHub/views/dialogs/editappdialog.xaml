<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="AppHub.Views.Dialogs.EditAppDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="编辑应用"
        Width="540"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource AppBgBrush}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
  <Grid Margin="22">
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Border Style="{StaticResource PanelBorder}" Background="{DynamicResource CardBgBrush}" Padding="22">
      <StackPanel>
        <!-- Header -->
        <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
          <TextBlock x:Name="DialogHeaderIcon"
                     Text="&#xE70F;"
                     Style="{StaticResource IconGlyph}"
                     FontSize="17"
                     Foreground="{DynamicResource AccentBrush}" />
          <TextBlock x:Name="DialogHeaderTitle"
                     Text="编辑应用配置"
                     FontSize="16"
                     FontWeight="SemiBold"
                     Foreground="{DynamicResource TextBrush}"
                     Margin="10,0,0,0"
                     VerticalAlignment="Center" />
        </StackPanel>

        <!-- Icon Live Preview Row -->
        <Border Background="{DynamicResource HoverBgBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="10"
                Padding="14,12"
                Margin="0,0,0,16">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border Width="48"
                    Height="48"
                    CornerRadius="11"
                    Background="{DynamicResource CardBgBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1">
              <Image x:Name="IconPreviewImage" Stretch="Uniform" Margin="7" />
            </Border>
            <StackPanel Grid.Column="1" Margin="14,0,12,0" VerticalAlignment="Center">
              <TextBlock x:Name="IconModeText"
                         Text="当前：自动提取应用图标"
                         FontSize="13"
                         FontWeight="Medium"
                         Foreground="{DynamicResource TextBrush}" />
              <TextBlock x:Name="IconPathHintText"
                         Text="支持 PNG / ICO / JPG 自定义图标"
                         FontSize="11.5"
                         Foreground="{DynamicResource SubtleTextBrush}"
                         TextTrimming="CharacterEllipsis"
                         Margin="0,3,0,0" />
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
              <Button Content="更换图标" Padding="12,7" Style="{StaticResource SecondaryButton}" Click="OnBrowseCustomIcon" />
              <Button x:Name="ResetIconButton"
                      Margin="8,0,0,0"
                      Content="恢复默认"
                      Padding="10,7"
                      Style="{StaticResource SubtleButton}"
                      Click="OnResetIcon" />
            </StackPanel>
          </Grid>
        </Border>

        <!-- Core Field 1: DisplayName -->
        <TextBlock Text="显示名称 *" FontSize="12.5" Foreground="{DynamicResource SubtleTextBrush}" Margin="0,0,0,6" />
        <TextBox x:Name="DisplayNameBox"
                 Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}"
                 TextChanged="OnDisplayNameTextChanged" />
        <TextBlock x:Name="DisplayNameErrorText"
                   Text="请输入应用显示名称"
                   FontSize="12"
                   Foreground="{DynamicResource DangerBrush}"
                   Margin="2,4,0,0"
                   Visibility="Collapsed" />

        <!-- Core Field 2: GroupName -->
        <TextBlock Text="所属分组" FontSize="12.5" Foreground="{DynamicResource SubtleTextBrush}" Margin="0,14,0,6" />
        <ComboBox Style="{StaticResource DialogEditableComboBox}"
                  IsEditable="True"
                  IsTextSearchEnabled="False"
                  StaysOpenOnEdit="True"
                  ItemsSource="{Binding RelativeSource={RelativeSource AncestorType={x:Type Window}}, Path=AvailableGroupNames}"
                  Text="{Binding GroupName, UpdateSourceTrigger=PropertyChanged}" />
        <TextBlock Text="可直接选择已有分组，或输入新分组名称（留空归为未分组）"
                   FontSize="11.5"
                   Foreground="{DynamicResource SubtleTextBrush}"
                   Margin="2,4,0,0" />

        <!-- Core Field 3: TargetPath -->
        <TextBlock Text="目标路径 *" FontSize="12.5" Foreground="{DynamicResource SubtleTextBrush}" Margin="0,14,0,6" />
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBox x:Name="TargetPathBox"
                   Grid.Column="0"
                   Text="{Binding TargetPath, UpdateSourceTrigger=PropertyChanged}"
                   TextChanged="OnTargetPathTextChanged" />
          <Button Grid.Column="1"
                  Margin="8,0,0,0"
                  Content="浏览文件"
                  Padding="12,8"
                  Style="{StaticResource SecondaryButton}"
                  Click="OnBrowseTargetFile" />
          <Button Grid.Column="2"
                  Margin="6,0,0,0"
                  Content="文件夹"
                  Padding="12,8"
                  Style="{StaticResource SecondaryButton}"
                  Click="OnBrowseTargetFolder" />
        </Grid>
        <TextBlock x:Name="TargetPathErrorText"
                   Text="请输入有效的目标路径"
                   FontSize="12"
                   Foreground="{DynamicResource DangerBrush}"
                   Margin="2,4,0,0"
                   Visibility="Collapsed" />

        <!-- Collapsible Advanced Options -->
        <Expander x:Name="AdvancedExpander"
                  Margin="0,16,0,0"
                  Foreground="{DynamicResource TextBrush}"
                  BorderThickness="0">
          <Expander.Header>
            <TextBlock Text="高级选项（启动参数、工作目录与进程监控）"
                       FontSize="13"
                       FontWeight="Medium"
                       Foreground="{DynamicResource SubtleTextBrush}" />
          </Expander.Header>
          <StackPanel Margin="0,12,0,0">
            <TextBlock Text="启动参数" FontSize="12.5" Foreground="{DynamicResource SubtleTextBrush}" Margin="0,0,0,6" />
            <TextBox Text="{Binding Arguments, UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock Text="工作目录" FontSize="12.5" Foreground="{DynamicResource SubtleTextBrush}" Margin="0,12,0,6" />
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBox x:Name="WorkingDirectoryBox"
                       Grid.Column="0"
                       Text="{Binding WorkingDirectory, UpdateSourceTrigger=PropertyChanged}" />
              <Button Grid.Column="1"
                      Margin="8,0,0,0"
                      Content="浏览"
                      Padding="12,8"
                      Style="{StaticResource SecondaryButton}"
                      Click="OnBrowseWorkingDirectory" />
            </Grid>

            <CheckBox Margin="0,14,0,0" Content="跟踪进程运行状态" IsChecked="{Binding TrackProcess}" />
            <TextBlock Text="启用后，AppHub 将定时检测并展示该应用的运行状态"
                       FontSize="11.5"
                       Foreground="{DynamicResource SubtleTextBrush}"
                       Margin="30,2,0,0" />
          </StackPanel>
        </Expander>
      </StackPanel>
    </Border>

    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
      <Button x:Name="SaveButton" Content="保存" Padding="22,9" IsDefault="True" Click="OnSave" />
      <Button Margin="10,0,0,0" Content="取消" Style="{StaticResource SecondaryButton}" Padding="20,9" IsCancel="True" Click="OnCancel" />
    </StackPanel>
  </Grid>
</Window>
