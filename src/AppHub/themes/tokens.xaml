<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:system="clr-namespace:System.Windows.Controls;assembly=PresentationFramework">
  <system:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
  <FontFamily x:Key="AppFont">Segoe UI Variable, Segoe UI, Microsoft YaHei UI</FontFamily>
  <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

  <CornerRadius x:Key="ControlCornerRadius">8</CornerRadius>
  <CornerRadius x:Key="CardCornerRadius">12</CornerRadius>
  <CornerRadius x:Key="BadgeCornerRadius">6</CornerRadius>

  <Style x:Key="KeyboardFocusVisual">
    <Setter Property="Control.Template">
      <Setter.Value>
        <ControlTemplate>
          <Border Margin="-2"
                  CornerRadius="10"
                  BorderBrush="{DynamicResource AccentBrush}"
                  BorderThickness="2"
                  SnapsToDevicePixels="True" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="IconGlyph" TargetType="{x:Type TextBlock}">
    <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
    <Setter Property="FontSize" Value="15" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="HorizontalAlignment" Value="Center" />
  </Style>

  <Style x:Key="PanelBorder" TargetType="{x:Type Border}">
    <Setter Property="Background" Value="{DynamicResource ProgramCardBgBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="12" />
  </Style>
</ResourceDictionary>
