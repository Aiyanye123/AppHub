<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="AppHub.Views.Dialogs.AddAppDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="添加应用"
        Width="480"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource AppBgBrush}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
  <Grid Margin="22">
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Border Style="{StaticResource PanelBorder}" Background="{DynamicResource CardBgBrush}" Padding="20">
      <StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
          <TextBlock Text="&#xE8A5;" Style="{StaticResource IconGlyph}" FontSize="16" Foreground="{DynamicResource AccentBrush}" />
          <TextBlock Text="选择应用程序" FontSize="15.5" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" Margin="10,0,0,0" VerticalAlignment="Center" />
        </StackPanel>
        <TextBlock Text="文件路径" FontSize="12.5" Foreground="{DynamicResource SubtleTextBrush}" Margin="0,0,0,6" />
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBox Text="{Binding SelectedPath, UpdateSourceTrigger=PropertyChanged}" />
          <Button Grid.Column="1" Content="浏览" Margin="8,0,0,0" Style="{StaticResource SecondaryButton}" Padding="14,8" Click="OnBrowse" />
        </Grid>
      </StackPanel>
    </Border>
    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
      <Button Content="添加" Padding="20,9" IsDefault="True" Click="OnAdd" />
      <Button Margin="10,0,0,0" Content="取消" Style="{StaticResource SecondaryButton}" Padding="20,9" IsCancel="True" Click="OnCancel" />
    </StackPanel>
  </Grid>
</Window>
