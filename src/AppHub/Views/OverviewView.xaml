<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="AppHub.Views.OverviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:AppHub.Controls"
             xmlns:viewModels="clr-namespace:AppHub.ViewModels"
             Loaded="OnLoaded"
             Unloaded="OnUnloaded"
             PreviewKeyDown="OnPreviewKeyDown">
  <FrameworkElement.DataContext>
    <viewModels:OverviewViewModel />
  </FrameworkElement.DataContext>
  <UserControl.Resources>
    <Style x:Key="InspectorLabel" TargetType="{x:Type TextBlock}">
      <Setter Property="Foreground" Value="{DynamicResource SubtleTextBrush}" />
      <Setter Property="FontSize" Value="11.5" />
      <Setter Property="Margin" Value="0,0,0,4" />
    </Style>
    <Style x:Key="InspectorValue" TargetType="{x:Type TextBlock}">
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
      <Setter Property="FontSize" Value="12.5" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
      <Setter Property="Margin" Value="0,0,0,12" />
    </Style>
    <Style x:Key="GroupChipListBoxItem" TargetType="{x:Type ListBoxItem}">
      <Setter Property="Padding" Value="12,6" />
      <Setter Property="Margin" Value="0,0,6,0" />
      <Setter Property="Foreground" Value="{DynamicResource SubtleTextBrush}" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="FontWeight" Value="Medium" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocusVisual}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type ListBoxItem}">
            <Border Name="ChipBorder"
                    Background="Transparent"
                    BorderBrush="Transparent"
                    BorderThickness="1"
                    CornerRadius="7"
                    Padding="{TemplateBinding Padding}"
                    SnapsToDevicePixels="True">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="ChipBorder" Property="Background" Value="{DynamicResource HoverBgBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="ChipBorder" Property="Background" Value="{DynamicResource SelectedBgBrush}" />
                <Setter TargetName="ChipBorder" Property="BorderBrush" Value="{DynamicResource SelectedBorderBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                <Setter Property="FontWeight" Value="SemiBold" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </UserControl.Resources>

  <Grid Background="{DynamicResource PageRootBgBrush}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- Header Row: Title + Clickable Stat Filter Pills + Primary Actions -->
    <Grid Grid.Row="0" Margin="28,22,28,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <StackPanel Grid.Column="0" VerticalAlignment="Center">
        <TextBlock Text="应用总览" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" />
        <TextBlock Text="集中管理与快速启动常用应用" FontSize="12.5" Foreground="{DynamicResource SubtleTextBrush}" Margin="0,4,0,0" />
      </StackPanel>

      <!-- Stat Filter Pills -->
      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="28,0,0,0">
        <Button Height="40"
                Padding="14,0"
                Margin="0,0,10,0"
                Command="{Binding ShowAllAppsCommand}"
                ToolTip="查看全部应用">
          <Button.Style>
            <Style TargetType="{x:Type Button}" BasedOn="{StaticResource SecondaryButton}">
              <Setter Property="Background" Value="{DynamicResource ProgramCardBgBrush}" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding IsRunningFilterActive}" Value="False">
                  <Setter Property="BorderBrush" Value="{DynamicResource SelectedBorderBrush}" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </Button.Style>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock Text="&#xE8A9;" Style="{StaticResource IconGlyph}" FontSize="14" Foreground="{DynamicResource AccentBrush}" />
            <TextBlock Text="全部" FontSize="13" Foreground="{DynamicResource SubtleTextBrush}" Margin="8,0,6,0" VerticalAlignment="Center" />
            <TextBlock Text="{Binding TotalCount}" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" />
          </StackPanel>
        </Button>

        <Button Height="40"
                Padding="14,0"
                Command="{Binding ToggleRunningFilterCommand}"
                ToolTip="点击筛选运行中的应用">
          <Button.Style>
            <Style TargetType="{x:Type Button}" BasedOn="{StaticResource SecondaryButton}">
              <Setter Property="Background" Value="{DynamicResource ProgramCardBgBrush}" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding IsRunningFilterActive}" Value="True">
                  <Setter Property="Background" Value="{DynamicResource RunningBadgeBgBrush}" />
                  <Setter Property="BorderBrush" Value="{DynamicResource SuccessBrush}" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </Button.Style>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Ellipse Width="8" Height="8" Fill="{DynamicResource SuccessBrush}" VerticalAlignment="Center" />
            <TextBlock Text="运行中" FontSize="13" Foreground="{DynamicResource SubtleTextBrush}" Margin="8,0,6,0" VerticalAlignment="Center" />
            <TextBlock Text="{Binding RunningCount}" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
      </StackPanel>

      <!-- Header Primary Actions -->
      <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
        <Button Height="38"
                Padding="14,0"
                Margin="0,0,10,0"
                Style="{StaticResource SecondaryButton}"
                Command="{Binding RefreshCommand}"
                ToolTip="立即刷新进程状态 (F5)">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="&#xE72C;" Style="{StaticResource IconGlyph}" FontSize="13.5" Margin="0,0,7,0" />
            <TextBlock Text="刷新" />
          </StackPanel>
        </Button>

        <Button x:Name="AddMenuButton"
                Height="38"
                Padding="16,0"
                Click="OnAddMenuClick"
                ToolTip="添加应用或文件夹 (Ctrl+N)">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="&#xE710;" Style="{StaticResource IconGlyph}" FontSize="13.5" Margin="0,0,7,0" />
            <TextBlock Text="添加" />
            <TextBlock Text="&#xE70D;" Style="{StaticResource IconGlyph}" FontSize="10" Margin="8,0,0,0" />
          </StackPanel>
          <Button.ContextMenu>
            <ContextMenu Placement="Bottom">
              <MenuItem Click="OnAddClick" Header="添加应用 (EXE / LNK / BAT)" InputGestureText="Ctrl+N">
                <MenuItem.Icon>
                  <TextBlock Text="&#xE8A5;" Style="{StaticResource IconGlyph}" FontSize="14" Foreground="{DynamicResource AccentBrush}" />
                </MenuItem.Icon>
              </MenuItem>
              <MenuItem Click="OnAddFolderClick" Header="添加文件夹">
                <MenuItem.Icon>
                  <TextBlock Text="&#xE8B7;" Style="{StaticResource IconGlyph}" FontSize="14" Foreground="{DynamicResource AccentBrush}" />
                </MenuItem.Icon>
              </MenuItem>
            </ContextMenu>
          </Button.ContextMenu>
        </Button>
      </StackPanel>
    </Grid>

    <!-- Toolbar Row: Search + Segmented Group Chips + Sort & View Controls -->
    <Border Grid.Row="1" Margin="28,16,28,0" Padding="12,10" Style="{StaticResource PanelBorder}">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="280" MinWidth="200" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- Search Box with Ctrl+F hint and Clear Button -->
        <Grid Name="SearchHost" Grid.Column="0" Height="36" Margin="0,0,12,0" MouseDown="OnSearchHostMouseDown">
          <Border Name="SearchFrame"
                  Background="{DynamicResource CardBgBrush}"
                  BorderThickness="1.2"
                  CornerRadius="8">
            <Border.Style>
              <Style TargetType="{x:Type Border}">
                <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding IsMouseOver, ElementName=SearchHost}" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource SubtleTextBrush}" />
                  </DataTrigger>
                  <DataTrigger Binding="{Binding IsKeyboardFocusWithin, ElementName=SearchBox}" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </Border.Style>
          </Border>
          <TextBlock Text="&#xE721;"
                     Style="{StaticResource IconGlyph}"
                     FontSize="13.5"
                     IsHitTestVisible="False"
                     VerticalAlignment="Center"
                     Margin="12,0,0,0"
                     HorizontalAlignment="Left"
                     Foreground="{DynamicResource SubtleTextBrush}" />
          <TextBox Name="SearchBox"
                   Style="{x:Null}"
                   Margin="34,0,30,0"
                   BorderThickness="0"
                   Background="Transparent"
                   Foreground="{DynamicResource TextBrush}"
                   CaretBrush="{DynamicResource AccentBrush}"
                   SelectionBrush="{DynamicResource AccentBrush}"
                   VerticalContentAlignment="Center"
                   FontFamily="{StaticResource AppFont}"
                   FontSize="13.5"
                   Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" />
          <TextBlock Text="搜索应用或分组 (Ctrl+F)"
                     IsHitTestVisible="False"
                     VerticalAlignment="Center"
                     FontSize="13"
                     Margin="36,0,0,0"
                     Foreground="{DynamicResource SubtleTextBrush}">
            <TextBlock.Style>
              <Style TargetType="{x:Type TextBlock}">
                <Setter Property="Visibility" Value="Collapsed" />
                <Style.Triggers>
                  <DataTrigger Value="" Binding="{Binding Text, ElementName=SearchBox}">
                    <Setter Property="Visibility" Value="Visible" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
          <Button Width="24"
                  Height="24"
                  Padding="0"
                  Margin="0,0,6,0"
                  HorizontalAlignment="Right"
                  VerticalAlignment="Center"
                  Style="{StaticResource SubtleButton}"
                  Command="{Binding ClearSearchCommand}"
                  ToolTip="清空搜索 (Esc)"
                  Visibility="{Binding HasSearchQuery, Converter={StaticResource BooleanToVisibilityConverter}}">
            <TextBlock Text="&#xE711;" Style="{StaticResource IconGlyph}" FontSize="10.5" Foreground="{DynamicResource SubtleTextBrush}" />
          </Button>
        </Grid>

        <!-- Segmented Group Chips Bar -->
        <ListBox Grid.Column="1"
                 ItemsSource="{Binding GroupOptions}"
                 SelectedItem="{Binding SelectedGroup, Mode=TwoWay}"
                 ItemContainerStyle="{StaticResource GroupChipListBoxItem}"
                 Background="Transparent"
                 BorderThickness="0"
                 VerticalAlignment="Center"
                 ScrollViewer.HorizontalScrollBarVisibility="Auto"
                 ScrollViewer.VerticalScrollBarVisibility="Disabled">
          <ListBox.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center" />
            </ItemsPanelTemplate>
          </ListBox.ItemsPanel>
        </ListBox>

        <!-- Right Controls: Sort + Sort Direction + Density + View Mode -->
        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
          <Grid Margin="0,0,6,0">
            <ComboBox Width="116"
                      Height="36"
                      Padding="30,0,8,0"
                      ToolTip="排序方式"
                      ItemsSource="{Binding SortOptions}"
                      SelectedItem="{Binding SelectedSort, Mode=TwoWay}" />
            <TextBlock Text="&#xE8CB;"
                       Style="{StaticResource IconGlyph}"
                       FontSize="13"
                       Margin="11,0,0,0"
                       HorizontalAlignment="Left"
                       IsHitTestVisible="False"
                       Foreground="{DynamicResource SubtleTextBrush}" />
          </Grid>

          <Button Width="36"
                  Height="36"
                  Margin="0,0,6,0"
                  Style="{StaticResource IconButton}"
                  Command="{Binding ToggleSortDirectionCommand}"
                  ToolTip="{Binding SortDirectionTooltip}"
                  Visibility="{Binding IsSortDirectionVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
            <TextBlock Text="{Binding SortDirectionGlyph}" Style="{StaticResource IconGlyph}" FontSize="13.5" />
          </Button>

          <Button Width="36"
                  Height="36"
                  Margin="0,0,6,0"
                  Style="{StaticResource IconButton}"
                  Command="{Binding ToggleCompactModeCommand}"
                  ToolTip="{Binding CompactModeTooltip}"
                  Visibility="{Binding IsListView, Converter={StaticResource BooleanToVisibilityConverter}}">
            <TextBlock Text="&#xE8EC;" Style="{StaticResource IconGlyph}" FontSize="14" />
          </Button>

          <Button Width="36"
                  Height="36"
                  Style="{StaticResource IconButton}"
                  Command="{Binding ToggleViewModeCommand}"
                  ToolTip="{Binding ViewModeTooltip}">
            <TextBlock Text="{Binding ViewModeGlyph}" Style="{StaticResource IconGlyph}" FontSize="14" />
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <!-- Main Content Area: App List/Grid + On-Demand Slide-Out Inspector -->
    <Grid Grid.Row="2" Margin="28,14,28,22">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" MinWidth="540" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <Border Grid.Column="0" Style="{StaticResource PanelBorder}" ClipToBounds="True">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="38" />
          </Grid.RowDefinitions>

          <!-- Table Column Header (Hidden in Grid View) -->
          <Border Grid.Row="0"
                  Height="38"
                  BorderBrush="{DynamicResource BorderBrush}"
                  BorderThickness="0,0,0,1"
                  Padding="20,0"
                  Visibility="{Binding IsListView, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid VerticalAlignment="Center">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="32" />
                <ColumnDefinition Width="2.8*" />
                <ColumnDefinition Width="1.1*" />
                <ColumnDefinition Width="1.1*" />
                <ColumnDefinition Width="1.1*" />
                <ColumnDefinition Width="86" />
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="1" Text="名称" FontSize="12.5" Foreground="{DynamicResource SubtleTextBrush}" FontWeight="SemiBold" />
              <TextBlock Grid.Column="2" Text="分组" FontSize="12.5" Foreground="{DynamicResource SubtleTextBrush}" FontWeight="SemiBold" />
              <TextBlock Grid.Column="3" Text="状态" FontSize="12.5" Foreground="{DynamicResource SubtleTextBrush}" FontWeight="SemiBold" />
              <TextBlock Grid.Column="4" Text="最近启动" FontSize="12.5" Foreground="{DynamicResource SubtleTextBrush}" FontWeight="SemiBold" />
              <TextBlock Grid.Column="5" Text="操作" FontSize="12.5" Foreground="{DynamicResource SubtleTextBrush}" FontWeight="SemiBold" HorizontalAlignment="Right" Margin="0,0,6,0" />
            </Grid>
          </Border>

          <!-- App Items List / Grid -->
          <ListBox Grid.Row="1"
                   Name="AppsList"
                   Padding="0,6,0,6"
                   SelectedItem="{Binding SelectedApp, Mode=TwoWay}"
                   AllowDrop="True"
                   Background="#00FFFFFF"
                   BorderThickness="0"
                   ScrollViewer.VerticalScrollBarVisibility="Auto"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                   ScrollViewer.CanContentScroll="False"
                   ItemsSource="{Binding CurrentView}"
                   PreviewMouseLeftButtonDown="OnPreviewMouseLeftButtonDown"
                   PreviewMouseMove="OnPreviewMouseMove"
                   MouseDoubleClick="OnListMouseDoubleClick"
                   DragEnter="OnListDragEnter"
                   DragOver="OnListDragOver"
                   Drop="OnDrop">
            <ListBox.Style>
              <Style TargetType="{x:Type ListBox}">
                <Setter Property="ItemsPanel">
                  <Setter.Value>
                    <ItemsPanelTemplate>
                      <VirtualizingStackPanel />
                    </ItemsPanelTemplate>
                  </Setter.Value>
                </Setter>
                <Style.Triggers>
                  <DataTrigger Binding="{Binding IsGridView}" Value="True">
                    <Setter Property="ItemsPanel">
                      <Setter.Value>
                        <ItemsPanelTemplate>
                          <WrapPanel Orientation="Horizontal" Margin="10,4" />
                        </ItemsPanelTemplate>
                      </Setter.Value>
                    </Setter>
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </ListBox.Style>
            <ItemsControl.ItemContainerStyle>
              <Style TargetType="{x:Type ListBoxItem}">
                <Setter Property="Padding" Value="0" />
                <Setter Property="Margin" Value="8,0,8,4" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Background" Value="#00FFFFFF" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Focusable" Value="True" />
                <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocusVisual}" />
                <Setter Property="AllowDrop" Value="True" />
                <Setter Property="Tag" Value="" />
                <Setter Property="Template">
                  <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ListBoxItem}">
                      <Grid>
                        <Border Name="DragSurface"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9"
                                Opacity="1"
                                RenderTransformOrigin="0.5,0.5">
                          <Border.RenderTransform>
                            <TransformGroup>
                              <ScaleTransform ScaleX="1" ScaleY="1" />
                              <TranslateTransform X="0" Y="0" />
                            </TransformGroup>
                          </Border.RenderTransform>
                          <ContentPresenter Margin="{TemplateBinding Padding}"
                                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                        <Rectangle Name="InsertLineTop"
                                   Height="2.5"
                                   Fill="{DynamicResource AccentBrush}"
                                   HorizontalAlignment="Stretch"
                                   VerticalAlignment="Top"
                                   Margin="10,0"
                                   Visibility="Collapsed" />
                        <Rectangle Name="InsertLineBottom"
                                   Height="2.5"
                                   Fill="{DynamicResource AccentBrush}"
                                   HorizontalAlignment="Stretch"
                                   VerticalAlignment="Bottom"
                                   Margin="10,0"
                                   Visibility="Collapsed" />
                      </Grid>
                      <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                          <Setter TargetName="DragSurface" Property="Background" Value="{DynamicResource HoverBgBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                          <Setter TargetName="DragSurface" Property="Background" Value="{DynamicResource SelectedBgBrush}" />
                          <Setter TargetName="DragSurface" Property="BorderBrush" Value="{DynamicResource SelectedBorderBrush}" />
                        </Trigger>
                        <Trigger Property="Tag" Value="Top">
                          <Setter TargetName="InsertLineTop" Property="Visibility" Value="Visible" />
                          <Setter TargetName="DragSurface" Property="Background" Value="{DynamicResource DropTargetBgBrush}" />
                        </Trigger>
                        <Trigger Property="Tag" Value="Bottom">
                          <Setter TargetName="InsertLineBottom" Property="Visibility" Value="Visible" />
                          <Setter TargetName="DragSurface" Property="Background" Value="{DynamicResource DropTargetBgBrush}" />
                        </Trigger>
                        <Trigger Property="Tag" Value="Dragging">
                          <Setter TargetName="DragSurface" Property="Opacity" Value="0.78" />
                          <Setter TargetName="DragSurface" Property="Background" Value="{DynamicResource DropTargetBgBrush}" />
                          <Setter TargetName="DragSurface" Property="BorderBrush" Value="{DynamicResource SuccessBrush}" />
                          <Setter TargetName="DragSurface" Property="RenderTransform">
                            <Setter.Value>
                              <TransformGroup>
                                <ScaleTransform ScaleX="0.985" ScaleY="0.985" />
                                <TranslateTransform X="0" Y="-2" />
                              </TransformGroup>
                            </Setter.Value>
                          </Setter>
                        </Trigger>
                      </ControlTemplate.Triggers>
                    </ControlTemplate>
                  </Setter.Value>
                </Setter>
                <EventSetter Event="DragEnter" Handler="OnItemDragEnter" />
                <EventSetter Event="DragOver" Handler="OnItemDragOver" />
                <EventSetter Event="DragLeave" Handler="OnItemDragLeave" />
                <EventSetter Event="Drop" Handler="OnItemDrop" />
              </Style>
            </ItemsControl.ItemContainerStyle>
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="{x:Type viewModels:AppItemViewModel}">
                <controls:AppCard />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ListBox>

          <!-- Empty State 1: No Apps Added Yet -->
          <Border Grid.Row="1"
                  Background="Transparent"
                  AllowDrop="True"
                  DragEnter="OnListDragEnter"
                  DragOver="OnListDragOver"
                  Drop="OnDrop"
                  Visibility="{Binding HasNoApps, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
              <Border Width="64"
                      Height="64"
                      CornerRadius="16"
                      Background="{DynamicResource HoverBgBrush}"
                      HorizontalAlignment="Center">
                <TextBlock Text="&#xECAA;" Style="{StaticResource IconGlyph}" FontSize="30" Foreground="{DynamicResource AccentBrush}" />
              </Border>
              <TextBlock Text="还没有添加任何应用"
                         FontSize="17"
                         FontWeight="SemiBold"
                         Foreground="{DynamicResource TextBrush}"
                         HorizontalAlignment="Center"
                         Margin="0,16,0,6" />
              <TextBlock Text="将 .exe、.lnk、.bat 或文件夹直接拖入此处，或点击下方按钮添加"
                         FontSize="13"
                         Foreground="{DynamicResource SubtleTextBrush}"
                         HorizontalAlignment="Center" />
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,18,0,0">
                <Button Content="添加应用" Padding="16,8" Click="OnAddClick" />
                <Button Content="添加文件夹" Margin="10,0,0,0" Padding="16,8" Style="{StaticResource SecondaryButton}" Click="OnAddFolderClick" />
              </StackPanel>
            </StackPanel>
          </Border>

          <!-- Empty State 2: Filter / Search Returned No Results -->
          <Border Grid.Row="1"
                  Background="Transparent"
                  Visibility="{Binding IsFilterEmpty, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
              <Border Width="60"
                      Height="60"
                      CornerRadius="15"
                      Background="{DynamicResource HoverBgBrush}"
                      HorizontalAlignment="Center">
                <TextBlock Text="&#xE721;" Style="{StaticResource IconGlyph}" FontSize="26" Foreground="{DynamicResource SubtleTextBrush}" />
              </Border>
              <TextBlock Text="未找到匹配的应用"
                         FontSize="16"
                         FontWeight="SemiBold"
                         Foreground="{DynamicResource TextBrush}"
                         HorizontalAlignment="Center"
                         Margin="0,14,0,6" />
              <TextBlock Text="当前搜索词或筛选条件下没有匹配结果"
                         FontSize="13"
                         Foreground="{DynamicResource SubtleTextBrush}"
                         HorizontalAlignment="Center" />
              <Button Content="清除搜索与筛选"
                      Margin="0,16,0,0"
                      Padding="16,8"
                      HorizontalAlignment="Center"
                      Style="{StaticResource SecondaryButton}"
                      Command="{Binding ClearFiltersCommand}" />
            </StackPanel>
          </Border>

          <!-- Bottom Status & Shortcut Hint Bar + Inspector Toggle -->
          <Border Grid.Row="2"
                  BorderBrush="{DynamicResource BorderBrush}"
                  BorderThickness="0,1,0,0"
                  Padding="16,0">
            <DockPanel VerticalAlignment="Center">
              <Button DockPanel.Dock="Right"
                      Height="28"
                      Padding="10,0"
                      FontSize="12"
                      Style="{StaticResource SubtleButton}"
                      Command="{Binding ToggleInspectorCommand}"
                      IsEnabled="{Binding HasSelectedApp}"
                      ToolTip="展开或收起选中项详情面板 (Space)">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="&#xE946;" Style="{StaticResource IconGlyph}" FontSize="12.5" Margin="0,0,6,0" />
                  <TextBlock Text="{Binding InspectorToggleText}" />
                </StackPanel>
              </Button>
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="{Binding VisibleCountText}" FontSize="12.5" Foreground="{DynamicResource SubtleTextBrush}" VerticalAlignment="Center" />
                <TextBlock Text=" · 双击或按 Enter 启动 · Space 详情 · F2 编辑"
                           FontSize="12"
                           Foreground="{DynamicResource SubtleTextBrush}"
                           Opacity="0.8"
                           VerticalAlignment="Center" />
              </StackPanel>
            </DockPanel>
          </Border>
        </Grid>
      </Border>

      <Border x:Name="InspectorGap" Grid.Column="1" Width="0" Visibility="Collapsed" />

      <!-- On-Demand Slide-Out Inspector Panel -->
      <Border x:Name="InspectorPanel"
              Grid.Column="2"
              Width="0"
              Padding="18"
              Visibility="Collapsed"
              Style="{StaticResource PanelBorder}">
        <Grid DataContext="{Binding SelectedApp}">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <DockPanel Grid.Row="0">
            <Button DockPanel.Dock="Right"
                    Width="28"
                    Height="28"
                    Padding="0"
                    Style="{StaticResource SubtleButton}"
                    Command="{Binding DataContext.CloseInspectorCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    ToolTip="收起详情面板 (Esc)">
              <TextBlock Text="&#xE711;" Style="{StaticResource IconGlyph}" FontSize="12" Foreground="{DynamicResource SubtleTextBrush}" />
            </Button>
            <TextBlock Text="应用详情" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" />
          </DockPanel>

          <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,16,0,16">
            <Border Width="48"
                    Height="48"
                    CornerRadius="11"
                    Background="{DynamicResource HoverBgBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1">
              <Image Stretch="Uniform" Margin="8" Source="{Binding Icon}" />
            </Border>
            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center" Width="192">
              <TextBlock Text="{Binding DisplayName}"
                         FontSize="16"
                         FontWeight="SemiBold"
                         Foreground="{DynamicResource TextBrush}"
                         TextTrimming="CharacterEllipsis"
                         ToolTip="{Binding DisplayName}" />
              <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                <Border Padding="6,2" CornerRadius="5" Background="{DynamicResource BadgeBgBrush}">
                  <TextBlock Text="{Binding SourceTypeText}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" />
                </Border>
                <TextBlock Text="{Binding GroupDisplayName}" FontSize="12" Foreground="{DynamicResource SubtleTextBrush}" Margin="8,0,0,0" VerticalAlignment="Center" />
              </StackPanel>
            </StackPanel>
          </StackPanel>

          <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel>
              <Separator Margin="0,0,0,14" Background="{DynamicResource BorderBrush}" />
              <TextBlock Text="目标路径" Style="{StaticResource InspectorLabel}" />
              <TextBlock Text="{Binding TargetPath}" Style="{StaticResource InspectorValue}" TextWrapping="Wrap" TextTrimming="None" ToolTip="{Binding TargetPath}" />
              <TextBlock Text="工作目录" Style="{StaticResource InspectorLabel}" />
              <TextBlock Text="{Binding WorkingDirectoryDisplay}" Style="{StaticResource InspectorValue}" ToolTip="{Binding WorkingDirectoryDisplay}" />
              <TextBlock Text="启动参数" Style="{StaticResource InspectorLabel}" />
              <TextBlock Text="{Binding ArgumentsDisplay}" Style="{StaticResource InspectorValue}" ToolTip="{Binding ArgumentsDisplay}" />
              <TextBlock Text="进程跟踪" Style="{StaticResource InspectorLabel}" />
              <TextBlock Text="{Binding TrackProcessText}" Style="{StaticResource InspectorValue}" />
              <TextBlock Text="最近启动" Style="{StaticResource InspectorLabel}" />
              <TextBlock Text="{Binding LastLaunchDisplay}" Style="{StaticResource InspectorValue}" />
            </StackPanel>
          </ScrollViewer>

          <StackPanel Grid.Row="3" Margin="0,12,0,0">
            <Separator Margin="0,0,0,12" Background="{DynamicResource BorderBrush}" />
            <UniformGrid Columns="2" Rows="1">
              <Button Margin="0,0,6,0" Height="36" Style="{StaticResource SecondaryButton}" Command="{Binding OpenLocationCommand}">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="&#xE838;" Style="{StaticResource IconGlyph}" FontSize="13" Margin="0,0,6,0" />
                  <TextBlock Text="所在位置" />
                </StackPanel>
              </Button>
              <Button Margin="6,0,0,0" Height="36" Style="{StaticResource SecondaryButton}" Command="{Binding EditCommand}">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="&#xE70F;" Style="{StaticResource IconGlyph}" FontSize="13" Margin="0,0,6,0" />
                  <TextBlock Text="编辑配置" />
                </StackPanel>
              </Button>
            </UniformGrid>
            <Button Margin="0,8,0,0"
                    Height="36"
                    Style="{StaticResource DangerButton}"
                    Command="{Binding RemoveCommand}">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE74D;" Style="{StaticResource IconGlyph}" FontSize="13" Margin="0,0,6,0" />
                <TextBlock Text="移除应用" />
              </StackPanel>
            </Button>
          </StackPanel>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</UserControl>
