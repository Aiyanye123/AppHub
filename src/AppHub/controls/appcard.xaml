<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="AppHub.Controls.AppCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <UserControl.Resources>
    <Style x:Key="RowIconButton" TargetType="{x:Type Button}" BasedOn="{StaticResource SubtleButton}">
      <Setter Property="Width" Value="32" />
      <Setter Property="Height" Value="32" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="6,0,0,0" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
  </UserControl.Resources>

  <!-- Unified ContextMenu shared by row right-click and "More" button -->
  <UserControl.ContextMenu>
    <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
      <MenuItem Header="启动" Command="{Binding LaunchCommand}" InputGestureText="Enter">
        <MenuItem.Icon>
          <TextBlock Text="&#xE768;" Style="{StaticResource IconGlyph}" FontSize="13" Foreground="{DynamicResource SuccessBrush}" />
        </MenuItem.Icon>
      </MenuItem>
      <MenuItem Header="关闭" Command="{Binding CloseCommand}" IsEnabled="{Binding IsRunning}">
        <MenuItem.Icon>
          <TextBlock Text="&#xE711;" Style="{StaticResource IconGlyph}" FontSize="13" />
        </MenuItem.Icon>
      </MenuItem>
      <MenuItem Header="强制结束" Command="{Binding ForceCloseCommand}" IsEnabled="{Binding IsRunning}">
        <MenuItem.Icon>
          <TextBlock Text="&#xE74D;" Style="{StaticResource IconGlyph}" FontSize="13" Foreground="{DynamicResource WarningBrush}" />
        </MenuItem.Icon>
      </MenuItem>
      <Separator Background="{DynamicResource BorderBrush}" Margin="4,3" />
      <MenuItem Header="查看详情" Command="{Binding InspectCommand}" InputGestureText="Space">
        <MenuItem.Icon>
          <TextBlock Text="&#xE946;" Style="{StaticResource IconGlyph}" FontSize="13" />
        </MenuItem.Icon>
      </MenuItem>
      <MenuItem Header="编辑配置" Command="{Binding EditCommand}" InputGestureText="F2">
        <MenuItem.Icon>
          <TextBlock Text="&#xE70F;" Style="{StaticResource IconGlyph}" FontSize="13" />
        </MenuItem.Icon>
      </MenuItem>
      <MenuItem Header="打开所在位置" Command="{Binding OpenLocationCommand}" InputGestureText="Ctrl+Enter">
        <MenuItem.Icon>
          <TextBlock Text="&#xE838;" Style="{StaticResource IconGlyph}" FontSize="13" />
        </MenuItem.Icon>
      </MenuItem>
      <MenuItem Header="{Binding PinMenuText}" Command="{Binding TogglePinCommand}" IsEnabled="{Binding CanTogglePin}">
        <MenuItem.Icon>
          <TextBlock Text="&#xE734;" Style="{StaticResource IconGlyph}" FontSize="13" Foreground="{DynamicResource WarningBrush}" />
        </MenuItem.Icon>
      </MenuItem>
      <Separator Background="{DynamicResource BorderBrush}" Margin="4,3" />
      <MenuItem Header="移除" Command="{Binding RemoveCommand}" Style="{StaticResource DangerMenuItem}" InputGestureText="Delete">
        <MenuItem.Icon>
          <TextBlock Text="&#xE74D;" Style="{StaticResource IconGlyph}" FontSize="13" Foreground="{DynamicResource DangerBrush}" />
        </MenuItem.Icon>
      </MenuItem>
    </ContextMenu>
  </UserControl.ContextMenu>

  <Grid Background="Transparent">
    <!-- LIST ROW LAYOUT -->
    <Grid x:Name="CardRoot" Margin="12,0" Background="Transparent">
      <Grid.Style>
        <Style TargetType="{x:Type Grid}">
          <Setter Property="MinHeight" Value="54" />
          <Setter Property="Visibility" Value="Visible" />
          <Style.Triggers>
            <DataTrigger Binding="{Binding DataContext.IsCompactMode, RelativeSource={RelativeSource AncestorType=ListBox}}" Value="True">
              <Setter Property="MinHeight" Value="44" />
            </DataTrigger>
            <DataTrigger Binding="{Binding DataContext.IsGridView, RelativeSource={RelativeSource AncestorType=ListBox}}" Value="True">
              <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </Grid.Style>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="32" />
        <ColumnDefinition Width="2.8*" />
        <ColumnDefinition Width="1.1*" />
        <ColumnDefinition Width="1.1*" />
        <ColumnDefinition Width="1.1*" />
        <ColumnDefinition Width="86" />
      </Grid.ColumnDefinitions>

      <!-- Pin Star -->
      <TextBlock Grid.Column="0"
                 Text="&#xE735;"
                 Foreground="{DynamicResource WarningBrush}"
                 Style="{StaticResource IconGlyph}"
                 FontSize="13.5"
                 ToolTip="已置顶"
                 Visibility="{Binding ShowPinBadge, Converter={StaticResource BooleanToVisibilityConverter}}" />

      <!-- Icon + Corner Type Badge + Name (+ Optional Path Subtitle) -->
      <Grid Grid.Column="1" VerticalAlignment="Center" Margin="0,5">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid Width="36" Height="36">
          <Border CornerRadius="9"
                  Background="{DynamicResource HoverBgBrush}"
                  BorderBrush="{DynamicResource BorderBrush}"
                  BorderThickness="1">
            <Image Stretch="Uniform" Margin="6" Source="{Binding Icon}" />
          </Border>
          <Border Width="16"
                  Height="16"
                  CornerRadius="5"
                  HorizontalAlignment="Right"
                  VerticalAlignment="Bottom"
                  Margin="0,0,-3,-2"
                  Background="{DynamicResource CardBgBrush}"
                  BorderBrush="{DynamicResource BorderBrush}"
                  BorderThickness="1"
                  ToolTip="{Binding SourceTypeText}"
                  Visibility="{Binding ShowSourceBadge, Converter={StaticResource BooleanToVisibilityConverter}}">
            <TextBlock Text="{Binding SourceBadgeGlyph}"
                       Style="{StaticResource IconGlyph}"
                       FontSize="9.5"
                       Foreground="{DynamicResource AccentBrush}" />
          </Border>
        </Grid>

        <StackPanel Grid.Column="1" Margin="12,0,14,0" VerticalAlignment="Center">
          <TextBlock Text="{Binding DisplayName}"
                     FontSize="14"
                     FontWeight="SemiBold"
                     Foreground="{DynamicResource TextBrush}"
                     TextTrimming="CharacterEllipsis"
                     ToolTip="{Binding DisplayName}" />
          <TextBlock x:Name="PathSubtitle"
                     Text="{Binding TargetPath}"
                     FontSize="11.5"
                     Foreground="{DynamicResource SubtleTextBrush}"
                     TextTrimming="CharacterEllipsis"
                     Margin="0,2,0,0"
                     ToolTip="{Binding TargetPath}">
            <TextBlock.Style>
              <Style TargetType="{x:Type TextBlock}">
                <Setter Property="Visibility" Value="Visible" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding DataContext.IsCompactMode, RelativeSource={RelativeSource AncestorType=ListBox}}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
        </StackPanel>
      </Grid>

      <!-- Group Pill -->
      <Border Grid.Column="2"
              Padding="8,3"
              CornerRadius="6"
              Background="{DynamicResource HoverBgBrush}"
              HorizontalAlignment="Left"
              VerticalAlignment="Center">
        <TextBlock Text="{Binding GroupDisplayName}"
                   FontSize="12"
                   Foreground="{DynamicResource SubtleTextBrush}"
                   TextTrimming="CharacterEllipsis"
                   MaxWidth="120" />
      </Border>

      <!-- Running / Launching Status -->
      <Border Grid.Column="3"
              Padding="9,3"
              CornerRadius="10"
              HorizontalAlignment="Left"
              VerticalAlignment="Center"
              Visibility="{Binding ShowStatusBadge, Converter={StaticResource BooleanToVisibilityConverter}}">
        <Border.Style>
          <Style TargetType="{x:Type Border}">
            <Setter Property="Background" Value="{DynamicResource RunningBadgeBgBrush}" />
            <Style.Triggers>
              <DataTrigger Binding="{Binding IsLaunching}" Value="True">
                <Setter Property="Background" Value="{DynamicResource LaunchingBadgeBgBrush}" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </Border.Style>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Ellipse Width="7" Height="7">
            <Ellipse.Style>
              <Style TargetType="{x:Type Ellipse}">
                <Setter Property="Fill" Value="{DynamicResource SuccessBrush}" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding IsLaunching}" Value="True">
                    <Setter Property="Fill" Value="{DynamicResource WarningBrush}" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </Ellipse.Style>
          </Ellipse>
          <TextBlock Text="{Binding ActiveStatusText}"
                     FontSize="12"
                     FontWeight="SemiBold"
                     Margin="6,0,0,0">
            <TextBlock.Style>
              <Style TargetType="{x:Type TextBlock}">
                <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding IsLaunching}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
        </StackPanel>
      </Border>

      <!-- Relative Last Launch Time -->
      <TextBlock Grid.Column="4"
                 Text="{Binding LastLaunchRelativeDisplay}"
                 ToolTip="{Binding LastLaunchTooltip}"
                 FontSize="12.5"
                 Foreground="{DynamicResource SubtleTextBrush}"
                 TextTrimming="CharacterEllipsis"
                 VerticalAlignment="Center" />

      <!-- Inline Actions -->
      <StackPanel Grid.Column="5" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
        <Button Style="{StaticResource RowIconButton}"
                Command="{Binding LaunchCommand}"
                ToolTip="启动 (Enter)">
          <TextBlock Text="&#xE768;" Style="{StaticResource IconGlyph}" FontSize="13" Foreground="{DynamicResource SuccessBrush}" />
        </Button>
        <Button Style="{StaticResource RowIconButton}"
                ToolTip="更多操作"
                Click="OnMoreClick">
          <TextBlock Text="&#xE712;" Style="{StaticResource IconGlyph}" FontSize="13" />
        </Button>
      </StackPanel>
    </Grid>

    <!-- GRID TILE LAYOUT -->
    <Border Width="172"
            Height="124"
            Padding="12,10"
            CornerRadius="10"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            Background="{DynamicResource CardBgBrush}"
            ToolTip="{Binding TargetPath}">
      <Border.Style>
        <Style TargetType="{x:Type Border}">
          <Setter Property="Visibility" Value="Collapsed" />
          <Style.Triggers>
            <DataTrigger Binding="{Binding DataContext.IsGridView, RelativeSource={RelativeSource AncestorType=ListBox}}" Value="True">
              <Setter Property="Visibility" Value="Visible" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </Border.Style>
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0">
          <TextBlock DockPanel.Dock="Left"
                     Text="&#xE735;"
                     Foreground="{DynamicResource WarningBrush}"
                     Style="{StaticResource IconGlyph}"
                     FontSize="12"
                     Visibility="{Binding ShowPinBadge, Converter={StaticResource BooleanToVisibilityConverter}}" />
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
            <Ellipse Width="8"
                     Height="8"
                     Margin="0,0,6,0"
                     ToolTip="{Binding ActiveStatusText}"
                     Visibility="{Binding ShowStatusBadge, Converter={StaticResource BooleanToVisibilityConverter}}"
                     Fill="{DynamicResource SuccessBrush}" />
            <Button Width="24"
                    Height="24"
                    Padding="0"
                    Style="{StaticResource SubtleButton}"
                    ToolTip="更多操作"
                    Click="OnMoreClick">
              <TextBlock Text="&#xE712;" Style="{StaticResource IconGlyph}" FontSize="12" />
            </Button>
          </StackPanel>
        </DockPanel>

        <Grid Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Width="42" Height="42" Margin="0,2">
          <Border CornerRadius="10"
                  Background="{DynamicResource HoverBgBrush}"
                  BorderBrush="{DynamicResource BorderBrush}"
                  BorderThickness="1">
            <Image Stretch="Uniform" Margin="6" Source="{Binding Icon}" />
          </Border>
          <Border Width="16"
                  Height="16"
                  CornerRadius="5"
                  HorizontalAlignment="Right"
                  VerticalAlignment="Bottom"
                  Margin="0,0,-3,-2"
                  Background="{DynamicResource CardBgBrush}"
                  BorderBrush="{DynamicResource BorderBrush}"
                  BorderThickness="1"
                  Visibility="{Binding ShowSourceBadge, Converter={StaticResource BooleanToVisibilityConverter}}">
            <TextBlock Text="{Binding SourceBadgeGlyph}"
                       Style="{StaticResource IconGlyph}"
                       FontSize="9.5"
                       Foreground="{DynamicResource AccentBrush}" />
          </Border>
        </Grid>

        <StackPanel Grid.Row="2" HorizontalAlignment="Center">
          <TextBlock Text="{Binding DisplayName}"
                     FontSize="13"
                     FontWeight="SemiBold"
                     Foreground="{DynamicResource TextBrush}"
                     TextTrimming="CharacterEllipsis"
                     HorizontalAlignment="Center"
                     MaxWidth="148" />
          <TextBlock Text="{Binding GroupDisplayName}"
                     FontSize="11"
                     Foreground="{DynamicResource SubtleTextBrush}"
                     TextTrimming="CharacterEllipsis"
                     HorizontalAlignment="Center"
                     Margin="0,1,0,0"
                     MaxWidth="148" />
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</UserControl>
