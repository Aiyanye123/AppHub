<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="AppHub.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:AppHub.Views"
        Title="AppHub"
        Width="1280"
        Height="760"
        MinWidth="1040"
        MinHeight="640"
        Icon="pack://application:,,,/icon/AppHub.ico"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
  <Window.Resources>
    <Style x:Key="SidebarGlyph" TargetType="{x:Type TextBlock}">
      <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
      <Setter Property="FontSize" Value="17" />
      <Setter Property="Width" Value="24" />
      <Setter Property="TextAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
  </Window.Resources>
  <Grid>
    <Grid Name="BackgroundImageLayer" Visibility="Collapsed" IsHitTestVisible="False" />
    <Border Name="BackgroundOverlayLayer" Visibility="Collapsed" Background="Transparent" IsHitTestVisible="False" />
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <Border x:Name="SidebarRail"
              Grid.Column="0"
              Width="208"
              Background="{DynamicResource SidebarBgBrush}"
              BorderBrush="{DynamicResource BorderBrush}"
              BorderThickness="0,0,1,0"
              ClipToBounds="True"
              Panel.ZIndex="2">
        <DockPanel>
          <StackPanel x:Name="BrandContainer" DockPanel.Dock="Top" Margin="18,22,18,24">
            <StackPanel x:Name="BrandRow" Orientation="Horizontal" HorizontalAlignment="Left">
              <Border x:Name="BrandIconFrame"
                      Width="42"
                      Height="42"
                      CornerRadius="11"
                      Background="{DynamicResource HoverBgBrush}"
                      BorderBrush="{DynamicResource BorderBrush}"
                      BorderThickness="1">
                <Image Width="30" Height="30" Stretch="Uniform" Source="pack://application:,,,/icon/apphub.ico" />
              </Border>
              <StackPanel x:Name="BrandCopy" Margin="12,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="AppHub" FontSize="17" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" />
                <TextBlock Text="应用总览启动器" FontSize="11.5" Foreground="{DynamicResource SubtleTextBrush}" Margin="0,2,0,0" />
              </StackPanel>
            </StackPanel>
          </StackPanel>

          <StackPanel x:Name="SidebarFooter" DockPanel.Dock="Bottom" Margin="14,0,14,18">
            <Button x:Name="ThemeToggleButton"
                    Height="38"
                    Margin="0,0,0,8"
                    Padding="12,0"
                    HorizontalContentAlignment="Left"
                    Style="{StaticResource SubtleButton}"
                    Click="OnToggleThemeClick"
                    ToolTip="切换浅色 / 深色主题">
              <StackPanel x:Name="ThemeToggleContent" Orientation="Horizontal">
                <TextBlock x:Name="ThemeToggleIcon" Text="&#xE708;" Style="{StaticResource SidebarGlyph}" Foreground="{DynamicResource AccentBrush}" />
                <TextBlock x:Name="ThemeToggleText" Text="深色模式" Margin="10,0,0,0" VerticalAlignment="Center" />
              </StackPanel>
            </Button>

            <Button x:Name="SidebarToggleButton"
                    Height="38"
                    Padding="12,0"
                    HorizontalContentAlignment="Left"
                    Style="{StaticResource SubtleButton}"
                    Click="OnToggleSidebarClick"
                    ToolTip="收起侧边栏">
              <StackPanel x:Name="SidebarToggleContent" Orientation="Horizontal">
                <TextBlock x:Name="SidebarToggleIcon" Text="&#xE76B;" Style="{StaticResource SidebarGlyph}" Foreground="{DynamicResource SubtleTextBrush}" />
                <TextBlock x:Name="SidebarToggleText" Text="收起侧边栏" Margin="10,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource SubtleTextBrush}" />
              </StackPanel>
            </Button>
          </StackPanel>

          <TabControl Name="MainTabControl"
                      TabStripPlacement="Left"
                      Margin="10,0,10,16"
                      Style="{StaticResource NavigationTabControl}">
            <TabItem>
              <TabItem.Header>
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="&#xE8A9;" Style="{StaticResource SidebarGlyph}" />
                  <TextBlock x:Name="OverviewNavText" Text="总览" Margin="10,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
              </TabItem.Header>
              <views:OverviewView x:Name="OverviewPageView" />
            </TabItem>
            <TabItem>
              <TabItem.Header>
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="&#xE713;" Style="{StaticResource SidebarGlyph}" />
                  <TextBlock x:Name="SettingsNavText" Text="设置" Margin="10,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
              </TabItem.Header>
              <views:SettingsView x:Name="SettingsPageView" />
            </TabItem>
          </TabControl>
        </DockPanel>
      </Border>

      <Grid Grid.Column="1" Panel.ZIndex="1">
        <ContentPresenter Content="{Binding SelectedContent, ElementName=MainTabControl}" />

        <!-- Non-blocking Toast / InfoBar Overlay -->
        <Border x:Name="ToastContainer"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Margin="0,0,28,24"
                MaxWidth="440"
                Padding="14,10"
                CornerRadius="10"
                Background="{DynamicResource ToastBgBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1.2"
                Visibility="Collapsed"
                Opacity="0"
                Panel.ZIndex="20">
          <Border.RenderTransform>
            <TranslateTransform x:Name="ToastTransform" Y="12" />
          </Border.RenderTransform>
          <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.18" Direction="270" />
          </Border.Effect>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="ToastIcon"
                       Grid.Column="0"
                       Text="&#xE946;"
                       Style="{StaticResource IconGlyph}"
                       FontSize="16"
                       Margin="0,0,10,0"
                       Foreground="{DynamicResource AccentBrush}" />
            <TextBlock x:Name="ToastText"
                       Grid.Column="1"
                       VerticalAlignment="Center"
                       TextWrapping="Wrap"
                       FontSize="13"
                       Foreground="{DynamicResource TextBrush}" />
            <Button x:Name="ToastActionButton"
                    Grid.Column="2"
                    Margin="12,0,0,0"
                    Padding="10,4"
                    FontSize="12.5"
                    FontWeight="SemiBold"
                    Foreground="{DynamicResource AccentBrush}"
                    Style="{StaticResource SubtleButton}"
                    Visibility="Collapsed"
                    Click="OnToastActionClick" />
            <Button Grid.Column="3"
                    Width="26"
                    Height="26"
                    Margin="6,0,0,0"
                    Padding="0"
                    Style="{StaticResource SubtleButton}"
                    Click="OnDismissToastClick"
                    ToolTip="关闭提示">
              <TextBlock Text="&#xE711;" Style="{StaticResource IconGlyph}" FontSize="11" Foreground="{DynamicResource SubtleTextBrush}" />
            </Button>
          </Grid>
        </Border>
      </Grid>
    </Grid>
  </Grid>
</Window>
